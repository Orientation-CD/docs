{
  "name": "yuanzhu-ai-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual technical documentation for YuanZhu AI WeChat/Douyin mini programs, workflows, administration and deployment.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:check": "node --test tests/*.test.mjs && node scripts/check-content.mjs && node scripts/check-traces.mjs && pnpm docs:build && node scripts/check-site.mjs",
    "docs:test:browser": "playwright test",
    "docs:sources": "node scripts/sync-sources.mjs",
    "docs:test:sources": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "linkedom": "^0.18.13",
    "mermaid": "^11.12.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  },
  "engines": {
    "node": ">=22.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "vitepress-plugin-mermaid@2.0.17": "patches/vitepress-plugin-mermaid@2.0.17.patch"
    }
  }
}
